# Firebase コンソールの「プロジェクトの設定 > マイアプリ > SDK の設定と構成」から転記します。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ローカル開発では / のままで構いません。GitHub Pages では Actions が自動設定します。
VITE_BASE_PATH=/

# 管理者PCだけで使うCloudinaryのアップロード設定です。GitHubのVariables / Secretsには登録しません。
# Cloudinary Console の Settings > API Keys から転記します。API Secret は絶対に公開しません。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 任意: Cloudinary Media Library 内の格納フォルダ。未指定時は tokai-profile-book。
CLOUDINARY_FOLDER=tokai-profile-book
# 任意: 画像を探すローカルフォルダ。未指定時は ./data/Images。
MENTOR_IMAGES_DIR=./data/Images

# 会場用の入場QRを発行するサイトURL。GitHub Pages公開後のURLを入れる（秘密情報ではない）。
# コマンドで --event-url を指定する場合は空欄でも構いません。
EVENT_ACCESS_URL=
